Analog.RigidityAnalysis.rigid_representation_of_local_fibers {K : ℕ} (hK : 4 ≤ K) {φ ψ : ℝ → ℝ} {E : ℝ → ℝ × ℝ}
  (hφ : ContinuousOn φ (Set.Icc (-1) 1)) (hC1φ : ContDiffOn ℝ 1 φ (Set.Ioo (-1) 1))
  (hE : ContinuousOn E (Set.Icc (-1) 1)) (hdE : DifferentiableOn ℝ E (Set.Ioo (-1) 1))
  (hnonaffine : ¬∃ c a, ∀ s ∈ Set.Icc (-1) 1, φ s = c + a * s)
  (hshape : StrictConvexOn ℝ (Set.Ioo (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Ioo (-1) 1) ψ)
  (hexact : Analog.GeneralCollision.ExactTarget K φ ψ E)
  (hfibers : Analog.RigidityAnalysis.LocalPlanarMomentFibers (Set.Ioo (-1) 1) φ E) :
  ∃ e, e.det ≠ 0 ∧ ∀ s ∈ Set.Icc (-1) 1, E s = e.encoder φ s
Analog.SmallNoise.leading_mse_power_exact.{u_1, u_2} {Ω : Type u_1} {E : Type u_2} [MeasurableSpace Ω]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
  {μ : MeasureTheory.Measure Ω} {D : E → ℝ} {L : NNReal} (hD : LipschitzWith L D) {r z : Ω → E} {f : Ω → ℝ}
  (hr : Measurable r) (hz : Measurable z) (hz2 : MeasureTheory.Integrable (fun ω => ‖z ω‖ ^ 2) μ)
  (hexact : ∀ᵐ (ω : Ω) ∂μ, D (r ω) = f ω) {J : Ω → E →L[ℝ] ℝ} (hJ : ∀ᵐ (ω : Ω) ∂μ, HasFDerivAt D (J ω) (r ω)) :
  Filter.Tendsto (fun N => (∫ (ω : Ω), (D (r ω + √N • z ω) - f ω) ^ 2 ∂μ) / N) (nhdsWithin 0 (Set.Ioi 0))
    (nhds (∫ (ω : Ω), (J ω) (z ω) ^ 2 ∂μ))
Analog.SmallNoise.variance_leading_mse.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
  (e : Analog.Curve) {K : ℕ} (hK : 2 ≤ K) (hdet : 0 < e.A * e.B - e.C ^ 2) {r z : Ω → ℂ} {f : Ω → ℝ} (hr : Measurable r)
  (hz : Measurable z) (hz2 : MeasureTheory.Integrable (fun ω => ‖z ω‖ ^ 2) μ)
  (hexact : ∀ᵐ (ω : Ω) ∂μ, e.explicitVarianceDecoder K (r ω) = f ω)
  (hmean :
    ∀ᵐ (ω : Ω) ∂μ,
      -1 < (e.inverseMoments K (Analog.complexCoordinates (r ω))).1 ∧
        (e.inverseMoments K (Analog.complexCoordinates (r ω))).1 < 1) :
  Filter.Tendsto (fun N => (∫ (ω : Ω), (e.explicitVarianceDecoder K (r ω + √N • z ω) - f ω) ^ 2 ∂μ) / N)
    (nhdsWithin 0 (Set.Ioi 0)) (nhds (∫ (ω : Ω), (fderiv ℝ (e.explicitVarianceDecoder K) (r ω)) (z ω) ^ 2 ∂μ))
Analog.FrontierAttainment.frontier_attained_on_maximal_interval {φ : ℝ → ℝ} {P a b μ v : ℝ} (hP : 0 < P) (hv : 0 < v)
  (hab : a ≠ b) (hcφ : ContinuousOn φ (Set.Icc (-1) 1))
  (hshape : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ) :
  ∃ q,
    Analog.SynthesisAttainment.Feasible φ P a b q ∧
      0 < q 6 ∧
        (∀ (r : Analog.SynthesisAttainment.Coordinates), Analog.SynthesisAttainment.Feasible φ P a b r → r 6 ≤ q 6) ∧
          ∀ (γ : ℝ), 0 ≤ γ → γ ≤ q 6 → ∃ D, Analog.Frontier.Optimal φ P a b μ v γ D
Analog.SynthesisAttainment.operational_maximum_attained {K : ℕ} (hK : 2 ≤ K) (φ ψ : ℝ → ℝ) {P : ℝ} (hP : 0 < P)
  (hcφ : ContinuousOn φ (Set.Icc (-1) 1))
  (hφ : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ)
  (hdφ : ∀ z ∈ Set.Ioo (-1) 1, DifferentiableAt ℝ φ z)
  (hψ : StrictConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) ψ)
  (hdψ : DifferentiableOn ℝ ψ (Set.Icc (-1) 1))
  (hcψ : ContinuousOn (Analog.GeneralScore.readoutSlope ψ) (Set.Icc (-1) 1)) :
  ∃ e,
    0 < Analog.GramSynthesis.det e.A e.B e.C ∧
      Analog.GeneralDesign.PeakFeasible e φ P ∧
        ContinuousOn (Analog.GeneralScore.encoder e φ) (Set.Icc (-1) 1) ∧
          Analog.GeneralCollision.ExactTarget K φ ψ (Analog.GeneralScore.encoder e φ) ∧
            0 < Analog.GeneralScore.score K φ ψ e ∧
              ∀ (f : Analog.Curve),
                Analog.GeneralDesign.PeakFeasible f φ P →
                  Analog.GeneralScore.score K φ ψ f ≤ Analog.GeneralScore.score K φ ψ e
def Analog.ArbitraryEncoder.varianceScore : ℕ → (ℝ → ℝ × ℝ) → ℝ :=
fun K E =>
  Analog.Operational.score {xs | Analog.ArbitraryEncoder.ValidInput K xs} (Analog.ArbitraryEncoder.variance K)
    fun xs ys =>
    Analog.ArbitraryEncoder.squaredDistance (Analog.ArbitraryEncoder.received E xs)
      (Analog.ArbitraryEncoder.received E ys)
def Analog.Operational.Quotients.{u_1} : {X : Type u_1} → Set X → (X → ℝ) → (X → X → ℝ) → Set ℝ :=
fun {X} D f cost => {q | ∃ x ∈ D, ∃ y ∈ D, f x ≠ f y ∧ q = cost x y / (f x - f y) ^ 2}
def Analog.Curve.PeakFeasibleAt : Analog.Curve → ℝ → Prop :=
fun e P => ∀ (s : ℝ), -1 ≤ s → s ≤ 1 → e.energy s ≤ P
