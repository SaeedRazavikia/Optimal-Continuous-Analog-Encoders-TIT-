Analog.AdditiveStatistics.exact_computation_of_gram (e : Analog.GramSynthesis.Planar) (K : ℕ) (γ : ℝ → ℝ × ℝ)
  (F : ℝ × ℝ → ℝ) (hD : 0 < Analog.GramSynthesis.det e.A e.B e.C) :
  Analog.AdditiveStatistics.ExactComputation K γ F (Analog.AdditiveStatistics.encoder e γ)
Analog.CompletionIdentification.triple_collision_preserves_statistics {K : ℕ} (hK : 4 ≤ K) (γ : ℝ → ℝ × ℝ)
  (F : ℝ × ℝ → ℝ) (E : ℝ → ℝ × ℝ) (hexact : Analog.AdditiveStatistics.ExactComputation K γ F E) (filler : ℝ)
  (hfiller : Analog.ArbitraryEncoder.InSource filler) (B : Set (ℝ × ℝ))
  (hidentify : Analog.CompletionIdentification.IdentifiesOn K γ F ((K - 4) • γ filler) B) (xs ys : List ℝ)
  (hxs : Analog.ArbitraryEncoder.ValidInput 3 xs) (hys : Analog.ArbitraryEncoder.ValidInput 3 ys)
  (hxsB : Analog.AdditiveStatistics.statisticSum γ xs ∈ B) (hysB : Analog.AdditiveStatistics.statisticSum γ ys ∈ B)
  (hcollision : Analog.ArbitraryEncoder.received E xs = Analog.ArbitraryEncoder.received E ys) :
