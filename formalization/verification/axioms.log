Analog.GaussianDesignAttainment.inverse_gram_design_minimum.{u_1, u_2} {K : ℕ} {S : Type u_1} {X : Type u_2}
  [TopologicalSpace S] [CompactSpace S] [TopologicalSpace X] (hK : 0 < K) (γ : Fin K → C(S, ℝ × ℝ))
  (hind : Analog.GaussianDesignCompactness.IndependentFeatures γ) {P : ℝ} (hP : 0 < P) (M : Set X) (hM : IsCompact M)
  (hne : M.Nonempty) (w : X → ℝ × ℝ) (hw : ContinuousOn w M)
  (hspan : Analog.GaussianDesignAttainment.GradientSpans M w) :
  ∃ p ∈ Analog.GaussianDesignCompactness.coefficientPeakSet γ P,
    Analog.GaussianDesignAttainment.coefficientDet p ≠ 0 ∧
      ∃ m ∈ M,
        (∀ m' ∈ M,
            Analog.GaussianDesignAttainment.inverseCoefficient p w m' ≤
              Analog.GaussianDesignAttainment.inverseCoefficient p w m) ∧
          ∀ p' ∈ Analog.GaussianDesignCompactness.coefficientPeakSet γ P,
            Analog.GaussianDesignAttainment.coefficientDet p' ≠ 0 →
              ∃ m' ∈ M,
                Analog.GaussianDesignAttainment.inverseCoefficient p w m ≤
                  Analog.GaussianDesignAttainment.inverseCoefficient p' w m'
Analog.EncoderRegularity.planar_affine_of_dense_charts {φ₁ φ₂ : ℝ → ℝ} {E : ℝ → Analog.EncoderRegularity.Plane}
  {O : Set Analog.EncoderRegularity.Plane} (h₁ : ContinuousOn φ₁ (Set.Icc (-1) 1))
  (h₂ : ContinuousOn φ₂ (Set.Icc (-1) 1)) (hE : ContinuousOn E (Set.Icc (-1) 1))
  (hC₁ : ContDiffOn ℝ 1 φ₁ (Set.Ioo (-1) 1)) (hC₂ : ContDiffOn ℝ 1 φ₂ (Set.Ioo (-1) 1))
  (hind : Analog.GeneralRigidity.NotInAffineLine (Set.Icc (-1) 1) φ₁ φ₂)
  (hdense : Analog.GeneralRigidity.regularTripleImage φ₁ φ₂ ⊆ closure O)
  (hf : Analog.EncoderRegularity.DensePlanarCharts φ₁ φ₂ E O) :
  ∃ c u v, ∀ x ∈ Set.Icc (-1) 1, E x = c + φ₁ x • u + φ₂ x • v
Analog.TwoStatisticPositivity.general_sdp_operational_attainment {K : ℕ} (hK : 4 ≤ K) {γ : ℝ → ℝ × ℝ} {F : ℝ × ℝ → ℝ}
  {P filler : ℝ} {L : NNReal} (hP : 0 < P) (hγ : ContinuousOn γ (Set.Icc (-1) 1))
  (hdγ : DifferentiableOn ℝ γ (Set.Ioo (-1) 1)) (hind : Analog.TwoStatisticAttainment.IndependentStatistics γ)
  (hn : Analog.Operational.NonconstantOn (Analog.AdditiveStatistics.attainable K γ) F)
  (hL : LipschitzOnWith L F (Analog.AdditiveStatistics.attainable K γ))
  (hfiller : Analog.ArbitraryEncoder.InSource filler)
  (hci : Analog.TwoStatisticPositivity.CommonCompletionCondition K γ F filler) :
  ∃ q,
    Analog.TwoStatisticAttainment.Feasible γ (Analog.AdditiveStatistics.attainable K γ) F P q ∧
      0 < q 6 ∧
        (∀ (r : Analog.TwoStatisticAttainment.Coordinates),
            Analog.TwoStatisticAttainment.Feasible γ (Analog.AdditiveStatistics.attainable K γ) F P r → r 6 ≤ q 6) ∧
          ∃ e,
            0 < Analog.GramSynthesis.det e.A e.B e.C ∧
              ContinuousOn (Analog.AdditiveStatistics.encoder e γ) (Set.Icc (-1) 1) ∧
                Analog.AdditiveStatistics.ExactComputation K γ F (Analog.AdditiveStatistics.encoder e γ) ∧
                  (∀ s ∈ Set.Icc (-1) 1,
                      Analog.ArbitraryEncoder.squaredDistance (Analog.AdditiveStatistics.encoder e γ s) 0 ≤ P) ∧
                    Analog.TwoStatisticDesign.score K γ F (Analog.AdditiveStatistics.encoder e γ) = ↑K ^ 2 * q 6
Analog.GeneralDecoder.decode_optimal (e : Analog.Curve) {K : ℕ} (hK : 2 ≤ K) (φ ψ : ℝ → ℝ)
  (hD : 0 < Analog.GramSynthesis.det e.A e.B e.C)
  (hφ : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ)
  (hdφ : ∀ z ∈ Set.Ioo (-1) 1, DifferentiableAt ℝ φ z)
  (hψ : ConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ ConcaveOn ℝ (Set.Icc (-1) 1) ψ) (hdψ : DifferentiableOn ℝ ψ (Set.Icc (-1) 1))
  (hcψ : ContinuousOn (Analog.GeneralScore.readoutSlope ψ) (Set.Icc (-1) 1)) :
  (∀ (xs : List ℝ),
      Analog.ArbitraryEncoder.ValidInput K xs →
        ∀ (N : ℂ),
          |Analog.GeneralDecoder.decode e K ψ
                  (Analog.ArbitraryEncoder.asComplex
                      (Analog.ArbitraryEncoder.received (Analog.GeneralScore.encoder e φ) xs) +
                    N) -
                Analog.GeneralCollision.target K φ ψ xs| ≤
            ↑(Analog.GeneralDecoder.amplification e K ψ) * ‖N‖) ∧
    ∀ (L : NNReal) (D : ℂ → ℝ),
      (∀ (xs : List ℝ),
          Analog.ArbitraryEncoder.ValidInput K xs →
            ∀ (N : ℂ),
              |D
                      (Analog.ArbitraryEncoder.asComplex
                          (Analog.ArbitraryEncoder.received (Analog.GeneralScore.encoder e φ) xs) +
                        N) -
                    Analog.GeneralCollision.target K φ ψ xs| ≤
                ↑L * ‖N‖) →
        Analog.GeneralDecoder.amplification e K ψ ≤ L
Analog.GaussianNoise.gaussian_clipped_leading_mse.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
  [MeasureTheory.IsProbabilityMeasure μ] (e : Analog.Curve) {K : ℕ} (hK : 0 < K) (ψ : ℝ → ℝ)
  (hD : 0 < Analog.GramSynthesis.det e.A e.B e.C) (hd : DifferentiableOn ℝ ψ (Set.Icc (-1) 1))
  (hc : ContinuousOn (Analog.GeneralScore.readoutSlope ψ) (Set.Icc (-1) 1))
  (hshape : ConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ ConcaveOn ℝ (Set.Icc (-1) 1) ψ) {r : Ω → ℂ} {f : Ω → ℝ} (hr : Measurable r)
  (hexact : ∀ᵐ (ω : Ω) ∂μ, Analog.GeneralDecoder.decode e K ψ (r ω) = f ω)
  (hmean :
    ∀ᵐ (ω : Ω) ∂μ,
      -1 < (e.inverseMoments K (Analog.complexCoordinates (r ω))).1 ∧
        (e.inverseMoments K (Analog.complexCoordinates (r ω))).1 < 1)
  (a b : ℝ) (hclip : ∀ᵐ (ω : Ω) ∂μ, a < f ω ∧ f ω < b) :
  Filter.Tendsto
    (fun N =>
      (∫ (p : Ω × ℂ),
          (Analog.Decoder.clip a b (Analog.GeneralDecoder.decode e K ψ (r p.1 + √N • p.2)) - f p.1) ^
            2 ∂μ.prod Analog.GaussianNoise.standardComplexGaussian) /
        N)
    (nhdsWithin 0 (Set.Ioi 0))
    (nhds
      (Analog.Frontier.risk (-∫ (ω : Ω), Analog.GeneralSmallNoise.slopeField e K ψ (r ω) ∂μ)
          (∫ (ω : Ω), Analog.GeneralSmallNoise.slopeField e K ψ (r ω) ^ 2 ∂μ -
            (∫ (ω : Ω), Analog.GeneralSmallNoise.slopeField e K ψ (r ω) ∂μ) ^ 2)
          { A := e.A, B := e.B, C := e.C } /
        (2 * ↑K ^ 2)))
Analog.QuadraticFrontier.clipped_curve_optimal_all_power {m M P γ : ℝ} (hm : 0 < m) (hmM : m < M) (hP : 0 < P)
  (hγ : 0 ≤ γ) (hγmax : γ ≤ P * Analog.QuadraticFrontier.separation M (Analog.GeneralQuadratic.optimalParameter M)) :
  let r := γ / P;
  have b := Analog.QuadraticFrontier.clippedParameter m M r ⋯ ⋯ ⋯;
  have e := Analog.Curve.scale (√P) (Analog.GeneralQuadratic.optimalCurve b);
  e.PeakFeasibleAt P ∧
    γ ≤ Analog.GeneralQuadratic.gramScore e M ∧
      Analog.QuadraticFrontier.curveRisk e m = (m ^ 2 / (b * (2 - b)) + 1 / b ^ 2) / P ∧
        ∀ (other : Analog.Curve),
          other.PeakFeasibleAt P →
            0 < other.A * other.B - other.C ^ 2 →
              γ ≤ Analog.GeneralQuadratic.gramScore other M →
                Analog.QuadraticFrontier.curveRisk e m ≤ Analog.QuadraticFrontier.curveRisk other m
Analog.CertifiedGrid.c2_grid_certificate (φ : ℝ → ℝ) (W : Analog.SynthesisAttainment.Anchors φ) (T : Finset ℝ)
  (P a b h Z₀ Z₁ Z₂ : ℝ) (hP : 0 < P) (hh : 0 ≤ h) (h₀ : 0 ≤ Z₀) (h₁ : 0 ≤ Z₁) (h₂ : 0 ≤ Z₂)
  (hW : ∀ (i : Fin 3), W.s i ∈ T) (hTa : -1 ∈ T) (hTb : 1 ∈ T) (hT : ∀ t ∈ T, t ∈ Set.Icc (-1) 1)
  (hspacing : ∀ l ∈ T, ∀ r ∈ T, l < r → (∀ t ∈ T, l < t → t < r → False) → r - l ≤ h)
  (hφ : ContDiffOn ℝ 2 φ (Set.Icc (-1) 1))
  (hz₀ : ∀ s ∈ Set.Icc (-1) 1, ‖Analog.CertifiedGrid.euclideanFeature φ s‖ ≤ Z₀)
  (hz₁ : ∀ s ∈ Set.Icc (-1) 1, ‖derivWithin (Analog.CertifiedGrid.euclideanFeature φ) (Set.Icc (-1) 1) s‖ ≤ Z₁)
  (hz₂ :
    ∀ s ∈ Set.Icc (-1) 1,
      ‖derivWithin (derivWithin (Analog.CertifiedGrid.euclideanFeature φ) (Set.Icc (-1) 1)) (Set.Icc (-1) 1) s‖ ≤ Z₂) :
  ∃ q qstar,
    Analog.CertifiedGrid.GridFeasible φ T P a b q ∧
      (∀ (r : Analog.SynthesisAttainment.Coordinates), Analog.CertifiedGrid.GridFeasible φ T P a b r → r 6 ≤ q 6) ∧
        Analog.SynthesisAttainment.Feasible φ P a b qstar ∧
          (∀ (r : Analog.SynthesisAttainment.Coordinates),
              Analog.SynthesisAttainment.Feasible φ P a b r → r 6 ≤ qstar 6) ∧
            have ρ := P / (P + 2 * ‖Analog.CertifiedGrid.gramOperator q‖ * (Z₁ ^ 2 + Z₀ * Z₂) * h ^ 2 / 8);
            (Analog.SynthesisAttainment.Feasible φ P a b fun i => ρ * q i) ∧ ρ * q 6 ≤ qstar 6 ∧ qstar 6 ≤ q 6
Analog.ApproximateRigidity.continuous_encoder_stability (K : ℕ) (P : ℝ) (ω : ℝ → ℝ)
  (hω : Filter.Tendsto ω (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)) (f : (Fin K → ↑Analog.ApproximateRigidity.Source) → ℝ)
  (hf : Continuous f) {L : ℝ} (hL : 0 ≤ L) (A : Set Analog.ApproximateRigidity.Encoder)
  (hclass :
    ∀ E ∈ Analog.ApproximateRigidity.encoderClass P ω,
      (∀ (s t : Fin K → ↑Analog.ApproximateRigidity.Source),
          Analog.ApproximateRigidity.sourceSuperposition K E s = Analog.ApproximateRigidity.sourceSuperposition K E t →
            f s = f t) →
        E ∈ A) :
  ∃ η,
    Monotone η ∧
      (∀ (ε : ℝ), 0 ≤ η ε) ∧
        η 0 = 0 ∧
          Filter.Tendsto η (nhdsWithin 0 (Set.Ici 0)) (nhds 0) ∧
            ∀ (ε : ℝ),
              0 ≤ ε →
                ∀ E ∈ Analog.ApproximateRigidity.encoderClass P ω,
                  ∀ (D : ℂ → ℝ),
                    LipschitzWith ⟨L, hL⟩ D →
                      (∀ (s : Fin K → ↑Analog.ApproximateRigidity.Source),
                          |D (Analog.ApproximateRigidity.sourceSuperposition K E s) - f s| ≤ ε) →
                        Metric.infDist E A ≤ η ε
