Analog.GaussianOptimizedMinimax.heterogeneous_optimized_minimax_achieved {K : ℕ} (hK : 0 < K)
  (γ : Fin K → ℝ → Analog.GaussianOptimizedMinimax.Plane) (hγ : ∀ (k : Fin K), ContinuousOn (γ k) (Set.Icc (-1) 1))
  (hind : ∀ (k : Fin K), Analog.TwoStatisticAttainment.IndependentStatistics (γ k)) {P : ℝ} (hP : 0 < P)
  (hregular : Analog.HeterogeneousScore.attainable γ ⊆ closure (interior (Analog.HeterogeneousScore.attainable γ)))
  (r₁ r₂ : Analog.GeneralTargetGaussianAchievability.IntervalReadout)
  (hrect :
    ∀ m ∈ Analog.HeterogeneousScore.attainable γ,
      Complex.equivRealProdCLM.symm m ∈ Analog.GeneralTargetGaussianAchievability.rectangle r₁ r₂)
  (hspan :
    Analog.GaussianDesignAttainment.GradientSpans (Analog.HeterogeneousScore.attainable γ)
      (Analog.GaussianOptimizedMinimax.prescribedCoordinates r₁ r₂)) :
  ∃ pstar,
    ∃ (hdet : Analog.GaussianDesignAttainment.coefficientDet pstar ≠ 0),
      pstar ∈
          Analog.GaussianDesignCompactness.coefficientPeakSet
            (Analog.HeterogeneousMomentCompactness.compactFeatures γ hγ) P ∧
        (∀
            p ∈
              Analog.GaussianDesignCompactness.coefficientPeakSet
                (Analog.HeterogeneousMomentCompactness.compactFeatures γ hγ) P,
            Analog.GaussianDesignAttainment.coefficientDet p ≠ 0 →
              Analog.GaussianOptimizedMinimax.prescribedMaximum (Analog.HeterogeneousScore.attainable γ) r₁ r₂ pstar ≤
                Analog.GaussianOptimizedMinimax.prescribedMaximum (Analog.HeterogeneousScore.attainable γ) r₁ r₂ p) ∧
          Filter.Tendsto
              (fun v =>
                Analog.GaussianOptimizedMinimax.rawOptimizedRisk
                    (Analog.HeterogeneousMomentCompactness.compactFeatures γ hγ) P
                    (Analog.HeterogeneousScore.attainable γ) (Analog.FixedPriorGaussianLimit.planeTarget r₁ r₂) v /
                  (2 * ↑v))
              (nhdsWithin 0 (Set.Ioi 0))
              (nhds
                (Analog.GaussianOptimizedMinimax.prescribedMaximum (Analog.HeterogeneousScore.attainable γ) r₁ r₂
                  pstar)) ∧
            Filter.Tendsto
              (fun N =>
                sSup
                  (Analog.GeneralTargetGaussianAchievability.normalizedRisk r₁ r₂
                      (Analog.GaussianParameterChannel.channelEquiv hK pstar hdet)
                      (Complex.equivRealProdCLM.symm (Analog.GaussianParameterChannel.totalOffset pstar)) N ''
                    (⇑Complex.equivRealProdCLM.symm '' Analog.HeterogeneousScore.attainable γ)))
              (nhdsWithin 0 (Set.Ioi 0))
              (nhds
                (Analog.GaussianOptimizedMinimax.prescribedMaximum (Analog.HeterogeneousScore.attainable γ) r₁ r₂
                  pstar))
