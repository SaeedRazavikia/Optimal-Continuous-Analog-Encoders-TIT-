  (hF : ContinuousOn F (Analog.HeterogeneousScore.attainable γ))
  (hn : Analog.Operational.NonconstantOn (Analog.HeterogeneousScore.attainable γ) F)
  (hs : 0 < Analog.HeterogeneousScore.score γ F (Analog.HeterogeneousScore.encoder e c γ)) :
  (∀ (y : ℂ),
      ∃ m ∈ Analog.HeterogeneousScore.attainable γ,
        Analog.CompactMinimumDecoder.momentDecoder e c γ F y =
          F m +
            ↑(Analog.CompactMinimumDecoder.momentConstant e c γ F) *
              dist y (Analog.CompactMinimumDecoder.momentReceived e c m)) ∧
    LipschitzWith (Analog.CompactMinimumDecoder.momentConstant e c γ F)
        (Analog.CompactMinimumDecoder.momentDecoder e c γ F) ∧
      (∀ s ∈ Analog.HeterogeneousScore.ValidInput K,
          ∀ (z : ℂ),
            |Analog.CompactMinimumDecoder.momentDecoder e c γ F
                    (Analog.ArbitraryEncoder.asComplex
                        (Analog.HeterogeneousScore.received (Analog.HeterogeneousScore.encoder e c γ) s) +
                      z) -
                  F (Analog.HeterogeneousScore.meanStatistic γ s)| ≤
              ↑(Analog.CompactMinimumDecoder.momentConstant e c γ F) * ‖z‖) ∧
        ∀ (L : NNReal) (D : ℂ → ℝ),
          (∀ s ∈ Analog.HeterogeneousScore.ValidInput K,
              ∀ (z : ℂ),
                |D
                        (Analog.ArbitraryEncoder.asComplex
                            (Analog.HeterogeneousScore.received (Analog.HeterogeneousScore.encoder e c γ) s) +
                          z) -
                      F (Analog.HeterogeneousScore.meanStatistic γ s)| ≤
                  ↑L * ‖z‖) →
            Analog.CompactMinimumDecoder.momentConstant e c γ F ≤ L
Analog.MinimumDecoderGaussianLimit.heterogeneous_fixed_prior_minimum {K : ℕ} (hK : 0 < K)
  (γ : Fin K → ℝ → Analog.MinimumDecoderGaussianLimit.Plane) (hγ : ∀ (k : Fin K), ContinuousOn (γ k) (Set.Icc (-1) 1))
  (a : Analog.HeterogeneousAttainment.Parameters K) (ha : Analog.GaussianDesignAttainment.coefficientDet a ≠ 0)
  {Ω : Set Analog.MinimumDecoderGaussianLimit.Plane} (hΩ : IsOpen Ω)
  (hΩM : Ω ⊆ interior (Analog.HeterogeneousScore.attainable γ)) (p : Analog.MinimumDecoderGaussianLimit.Plane → ℝ)
  (hp : Measurable p) (hp0 : ∀ (m : Analog.MinimumDecoderGaussianLimit.Plane), 0 ≤ p m)
  (hpi : MeasureTheory.Integrable p MeasureTheory.volume)
  (hpn : ∫ (m : Analog.MinimumDecoderGaussianLimit.Plane), p m = 1) (hpC : ContDiffOn ℝ 1 p Ω)
  (hpPos : ∀ m ∈ Ω, 0 < p m)
  (hfull : ∀ᵐ (m : Analog.MinimumDecoderGaussianLimit.Plane) ∂Analog.GaussianScoreIdentity.priorLaw p, m ∈ Ω)
  (r₁ r₂ : Analog.GeneralTargetGaussianAchievability.IntervalReadout)
  (hrect :
    ∀ m ∈ Analog.HeterogeneousScore.attainable γ,
      Complex.equivRealProdCLM.symm m ∈ Analog.GeneralTargetGaussianAchievability.rectangle r₁ r₂)
  (hn :
    Analog.Operational.NonconstantOn (Analog.HeterogeneousScore.attainable γ)
      (Analog.FixedPriorGaussianLimit.planeTarget r₁ r₂)) :
  have T := Analog.GaussianParameterChannel.channelEquiv hK a ha;
  have c := Analog.GaussianParameterChannel.totalOffset a;
  have J :=
    (∫ (m : Analog.GaussianScoreIdentity.Plane),
        Analog.GaussianDesignAttainment.inverseCoefficient a (fun z => (r₁.slope z.1, r₂.slope z.2))
          m ∂Analog.GaussianScoreIdentity.priorLaw p) /
      (2 * ↑K ^ 2);
  Filter.Tendsto
      (fun v =>
        Analog.GaussianBayesConverse.optimalRisk p (Analog.FixedPriorGaussianLimit.planeTarget r₁ r₂) T c v / (2 * ↑v))
      (nhdsWithin 0 (Set.Ioi 0)) (nhds J) ∧
    Filter.Tendsto
      (fun N =>
        Analog.MinimumDecoderGaussianLimit.minimumRisk p (Analog.MinimumDecoderGaussianLimit.complexMoments γ) r₁ r₂ T c
            N /
          N)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds J)
Analog.MinimumDecoderGaussianLimit.minimumDecoder_eq_paper_decoder {K : ℕ} (hK : 0 < K)
  (a : Analog.HeterogeneousAttainment.Parameters K) (ha : Analog.GaussianDesignAttainment.coefficientDet a ≠ 0)
  (γ : Fin K → ℝ → Analog.MinimumDecoderGaussianLimit.Plane)
  (r₁ r₂ : Analog.GeneralTargetGaussianAchievability.IntervalReadout) :
  Analog.MinimumDecoderGaussianLimit.minimumDecoder (Analog.MinimumDecoderGaussianLimit.complexMoments γ) r₁ r₂
      (Analog.GaussianParameterChannel.channelEquiv hK a ha)
      (Complex.equivRealProdCLM.symm (Analog.GaussianParameterChannel.totalOffset a)) =
    Analog.CompactMinimumDecoder.momentDecoder (Analog.HeterogeneousAttainment.parameterPlanar a) a.1 γ
      (Analog.FixedPriorGaussianLimit.planeTarget r₁ r₂)
Analog.FiniteNodeScore.lemma_one_score {K : ℕ} (hK : 4 ≤ K) (e : Analog.GramSynthesis.Planar) (c : Fin K → ℝ × ℝ)
  (φ ψ : ℝ → ℝ) (hD : 0 < Analog.GramSynthesis.det e.A e.B e.C)
  (hφ : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ)
  (hdφ : ContDiffOn ℝ 1 φ (Set.Ioo (-1) 1))
  (hψ : StrictConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) ψ)
  (hdψ : ContDiffOn ℝ 1 ψ (Set.Icc (-1) 1)) :
  Analog.HeterogeneousScore.score (Analog.FiniteNodeScore.sharedFeatures φ) (Analog.FiniteNodeScore.readout ψ)
      (Analog.HeterogeneousScore.encoder e c (Analog.FiniteNodeScore.sharedFeatures φ)) =
    ↑K ^ 2 /
      max (Analog.GramSynthesis.dual e.A e.B e.C (-Analog.GeneralScore.readoutSlope ψ (-1)) 1)
        (Analog.GramSynthesis.dual e.A e.B e.C (-Analog.GeneralScore.readoutSlope ψ 1) 1)
Analog.FiniteNodeScore.lemma_one_sharpness {K : ℕ} (hK : 4 ≤ K) (e : Analog.GramSynthesis.Planar) (c : Fin K → ℝ × ℝ)
  (φ ψ : ℝ → ℝ) (hD : 0 < Analog.GramSynthesis.det e.A e.B e.C)
  (hφ : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ)
  (hdφ : ContDiffOn ℝ 1 φ (Set.Ioo (-1) 1))
  (hψ : StrictConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) ψ)
  (hdψ : ContDiffOn ℝ 1 ψ (Set.Icc (-1) 1)) (ε δ : ℝ) (hε : 0 < ε) (hδ : 0 < δ) :
  ∃ s t,
    s ∈ Analog.HeterogeneousScore.ValidInput K ∧
      t ∈ Analog.HeterogeneousScore.ValidInput K ∧
        Analog.FiniteNodeScore.readout ψ
              (Analog.HeterogeneousScore.meanStatistic (Analog.FiniteNodeScore.sharedFeatures φ) s) ≠
            Analog.FiniteNodeScore.readout ψ
              (Analog.HeterogeneousScore.meanStatistic (Analog.FiniteNodeScore.sharedFeatures φ) t) ∧
          Analog.ArbitraryEncoder.squaredDistance
                (Analog.HeterogeneousScore.received
                  (Analog.HeterogeneousScore.encoder e c (Analog.FiniteNodeScore.sharedFeatures φ)) s)
                (Analog.HeterogeneousScore.received
                  (Analog.HeterogeneousScore.encoder e c (Analog.FiniteNodeScore.sharedFeatures φ)) t) <
              δ ^ 2 ∧
            Analog.ArbitraryEncoder.squaredDistance
                  (Analog.HeterogeneousScore.received
                    (Analog.HeterogeneousScore.encoder e c (Analog.FiniteNodeScore.sharedFeatures φ)) s)
                  (Analog.HeterogeneousScore.received
                    (Analog.HeterogeneousScore.encoder e c (Analog.FiniteNodeScore.sharedFeatures φ)) t) /
                (Analog.FiniteNodeScore.readout ψ
                      (Analog.HeterogeneousScore.meanStatistic (Analog.FiniteNodeScore.sharedFeatures φ) s) -
                    Analog.FiniteNodeScore.readout ψ
                      (Analog.HeterogeneousScore.meanStatistic (Analog.FiniteNodeScore.sharedFeatures φ) t)) ^
                  2 <
              Analog.HeterogeneousScore.score (Analog.FiniteNodeScore.sharedFeatures φ)
                  (Analog.FiniteNodeScore.readout ψ)
                  (Analog.HeterogeneousScore.encoder e c (Analog.FiniteNodeScore.sharedFeatures φ)) +
                ε
Analog.PolynomialGlobalOptima.quadratic_global_optimal {K : ℕ} (hK : 4 ≤ K) (P : ℝ) (hP : 0 < P) (ψ : ℝ → ℝ)
  (hψ : ContDiffOn ℝ 1 ψ (Set.Icc (-1) 1)) (heven : ∀ x ∈ Set.Icc (-1) 1, ψ (-x) = ψ x)
  (hshape : StrictConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) ψ) :
  have M := |Analog.GeneralScore.readoutSlope ψ 1|;
  have b := Analog.GeneralQuadratic.optimalParameter M;
  have e := Analog.Curve.scale (√P) (Analog.GeneralQuadratic.optimalCurve b);
  (∀ (i : Fin K),
      ∀ s ∈ Set.Icc (-1) 1,
        Analog.ArbitraryEncoder.squaredDistance (Analog.PolynomialGlobalOptima.sharedEncoder 2 e i s) 0 ≤ P) ∧
    Analog.HeterogeneousScore.score (fun x s => (s, s ^ 2)) (fun m => m.2 - ψ m.1)
          (Analog.PolynomialGlobalOptima.sharedEncoder 2 e) =
        ↑K ^ 2 * P * b ^ 2 * (b - 1) ∧
      ∀ (E : Fin K → ℝ → ℝ × ℝ),
        (∀ (i : Fin K), ContinuousOn (E i) (Set.Icc (-1) 1)) →
          (∀ (i : Fin K), ∀ s ∈ Set.Icc (-1) 1, Analog.ArbitraryEncoder.squaredDistance (E i s) 0 ≤ P) →
            Analog.HeterogeneousScore.score (fun x s => (s, s ^ 2)) (fun m => m.2 - ψ m.1) E ≤
              Analog.HeterogeneousScore.score (fun x s => (s, s ^ 2)) (fun m => m.2 - ψ m.1)
                (Analog.PolynomialGlobalOptima.sharedEncoder 2 e)
Analog.PolynomialGlobalOptima.quartic_global_optimal {K : ℕ} (hK : 4 ≤ K) (P : ℝ) (hP : 0 < P) (ψ : ℝ → ℝ)
  (hψ : ContDiffOn ℝ 1 ψ (Set.Icc (-1) 1)) (heven : ∀ x ∈ Set.Icc (-1) 1, ψ (-x) = ψ x)
  (hshape : StrictConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) ψ) :
  have M := |Analog.GeneralScore.readoutSlope ψ 1|;
  ∃ r,
    (0 < r ∧ r < 1 / 3 ∧ Analog.Quartic.RootEquation M r) ∧
      (∀ (r' : ℝ), 0 < r' → r' < 1 / 3 → Analog.Quartic.RootEquation M r' → r' = r) ∧
        have e := Analog.Curve.scale (√P) (Analog.Quartic.optimalPlanarCurve r);
        (∀ (i : Fin K),
            ∀ s ∈ Set.Icc (-1) 1,
              Analog.ArbitraryEncoder.squaredDistance (Analog.PolynomialGlobalOptima.sharedEncoder 4 e i s) 0 ≤ P) ∧
          Analog.HeterogeneousScore.score (fun x s => (s, s ^ 4)) (fun m => m.2 - ψ m.1)
                (Analog.PolynomialGlobalOptima.sharedEncoder 4 e) =
              ↑K ^ 2 * P / (M ^ 2 / √(Analog.Quartic.optA r) ^ 2 + 1 / Analog.Quartic.optb r ^ 2) ∧
            ∀ (E : Fin K → ℝ → ℝ × ℝ),
              (∀ (i : Fin K), ContinuousOn (E i) (Set.Icc (-1) 1)) →
                (∀ (i : Fin K), ∀ s ∈ Set.Icc (-1) 1, Analog.ArbitraryEncoder.squaredDistance (E i s) 0 ≤ P) →
                  Analog.HeterogeneousScore.score (fun x s => (s, s ^ 4)) (fun m => m.2 - ψ m.1) E ≤
                    Analog.HeterogeneousScore.score (fun x s => (s, s ^ 4)) (fun m => m.2 - ψ m.1)
                      (Analog.PolynomialGlobalOptima.sharedEncoder 4 e)
Analog.HeterogeneousFullRigidity.heterogeneous_rigidity {K : ℕ} (hK : 4 ≤ K) (φ₁ φ₂ : Fin K → ℝ → ℝ)
  (E : Fin K → ℝ → Analog.HeterogeneousRegularity.Plane) (ψ₁ ψ₂ : ℝ → ℝ)
  (h₁ : ∀ (i : Fin K), ContinuousOn (φ₁ i) (Set.Icc (-1) 1)) (h₂ : ∀ (i : Fin K), ContinuousOn (φ₂ i) (Set.Icc (-1) 1))
  (hE : ∀ (i : Fin K), ContinuousOn (E i) (Set.Icc (-1) 1))
  (hC₁ : ∀ (i : Fin K), ContDiffOn ℝ 1 (φ₁ i) (Set.Ioo (-1) 1))
  (hC₂ : ∀ (i : Fin K), ContDiffOn ℝ 1 (φ₂ i) (Set.Ioo (-1) 1))
  (hind : ∀ (i : Fin K), Analog.GeneralRigidity.NotInAffineLine (Set.Icc (-1) 1) (φ₁ i) (φ₂ i))
  (_hψ₁ : ContinuousOn ψ₁ (Analog.HeterogeneousFullRigidity.closedMeanDomain φ₁))
  (_hψ₂ : ContinuousOn ψ₂ (Analog.HeterogeneousFullRigidity.closedMeanDomain φ₂))
  (hψC₁ : ContDiffOn ℝ 1 ψ₁ (Analog.HeterogeneousCompletionDensity.meanDomain φ₁))
  (hψC₂ : ContDiffOn ℝ 1 ψ₂ (Analog.HeterogeneousCompletionDensity.meanDomain φ₂))
  (halt₁ : Analog.HeterogeneousFullRigidity.ReceiverAdmissible φ₁ ψ₁)
  (halt₂ : Analog.HeterogeneousFullRigidity.ReceiverAdmissible φ₂ ψ₂)
  (hn₁ : Analog.Operational.NonconstantOn (Analog.HeterogeneousFullRigidity.closedMeanDomain φ₁) ψ₁)
  (hn₂ : Analog.Operational.NonconstantOn (Analog.HeterogeneousFullRigidity.closedMeanDomain φ₂) ψ₂)
  (hna : ¬Analog.HeterogeneousFullRigidity.AffineOnMean φ₁ ψ₁ ∨ ¬Analog.HeterogeneousFullRigidity.AffineOnMean φ₂ ψ₂) :
  Analog.HeterogeneousScore.ExactComputation (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂)
      (fun m => ψ₁ m.1 + ψ₂ m.2) E ↔
    ∃ u v c, u.1 * v.2 - v.1 * u.2 ≠ 0 ∧ ∀ (i : Fin K), ∀ x ∈ Set.Icc (-1) 1, E i x = c i + φ₁ i x • u + φ₂ i x • v
Analog.HeterogeneousAttainment.heterogeneous_sdp_attained {K : ℕ} (hK : 0 < K) (γ : Fin K → ℝ → ℝ × ℝ) (F : ℝ × ℝ → ℝ)
  (hγ : ∀ (k : Fin K), ContinuousOn (γ k) (Set.Icc (-1) 1))
  (hn : Analog.Operational.NonconstantOn (Analog.HeterogeneousScore.attainable γ) F) {P : ℝ} (hP : 0 ≤ P) :
  ∃ q e c,
    Analog.HeterogeneousAttainment.SDPFeasible γ F P q ∧
      (∀ (q' : Analog.HeterogeneousAttainment.SDPPoint K),
          Analog.HeterogeneousAttainment.SDPFeasible γ F P q' → q'.lam ≤ q.lam) ∧
        (∀ (k : Fin K),
            ∀ s ∈ Set.Icc (-1) 1,
              Analog.ArbitraryEncoder.squaredDistance (Analog.HeterogeneousScore.encoder e c γ k s) 0 ≤ P) ∧
          Analog.HeterogeneousScore.score γ F (Analog.HeterogeneousScore.encoder e c γ) = ↑K ^ 2 * q.lam ∧
            ∀ (e' : Analog.GramSynthesis.Planar) (c' : Fin K → ℝ × ℝ),
              (∀ (k : Fin K),
                  ∀ s ∈ Set.Icc (-1) 1,
                    Analog.ArbitraryEncoder.squaredDistance (Analog.HeterogeneousScore.encoder e' c' γ k s) 0 ≤ P) →
                Analog.HeterogeneousScore.score γ F (Analog.HeterogeneousScore.encoder e' c' γ) ≤
                  Analog.HeterogeneousScore.score γ F (Analog.HeterogeneousScore.encoder e c γ)
Analog.HeterogeneousAttainment.optimal_positive_iff_euclidean_lipschitz {K : ℕ} (γ : Fin K → ℝ → ℝ × ℝ) (F : ℝ × ℝ → ℝ)
  (hγ : ∀ (k : Fin K), ContinuousOn (γ k) (Set.Icc (-1) 1)) {P : ℝ} (hP : 0 < P)
  {q : Analog.HeterogeneousAttainment.SDPPoint K} (hq : Analog.HeterogeneousAttainment.SDPFeasible γ F P q)
  (hmax :
    ∀ (q' : Analog.HeterogeneousAttainment.SDPPoint K),
      Analog.HeterogeneousAttainment.SDPFeasible γ F P q' → q'.lam ≤ q.lam) :
  0 < q.lam ↔ Analog.HeterogeneousAttainment.EuclideanLipschitzOn F (Analog.HeterogeneousScore.attainable γ)
Analog.HeterogeneousGlobalOptimum.unrestricted_sdp_attained {K : ℕ} (hK : 4 ≤ K) (φ₁ φ₂ : Fin K → ℝ → ℝ) (ψ₁ ψ₂ : ℝ → ℝ)
  (h₁ : ∀ (i : Fin K), ContinuousOn (φ₁ i) (Set.Icc (-1) 1)) (h₂ : ∀ (i : Fin K), ContinuousOn (φ₂ i) (Set.Icc (-1) 1))
  (hC₁ : ∀ (i : Fin K), ContDiffOn ℝ 1 (φ₁ i) (Set.Ioo (-1) 1))
  (hC₂ : ∀ (i : Fin K), ContDiffOn ℝ 1 (φ₂ i) (Set.Ioo (-1) 1))
  (hind : ∀ (i : Fin K), Analog.GeneralRigidity.NotInAffineLine (Set.Icc (-1) 1) (φ₁ i) (φ₂ i))
  (hψC₁ : ContDiffOn ℝ 1 ψ₁ (Analog.HeterogeneousCompletionDensity.meanDomain φ₁))
  (hψC₂ : ContDiffOn ℝ 1 ψ₂ (Analog.HeterogeneousCompletionDensity.meanDomain φ₂))
  (halt₁ : Analog.CompletionSeparation.ReceiverAlternative (Analog.HeterogeneousCompletionDensity.meanDomain φ₁) ψ₁)
  (halt₂ : Analog.CompletionSeparation.ReceiverAlternative (Analog.HeterogeneousCompletionDensity.meanDomain φ₂) ψ₂)
  (hna :
    Analog.CompletionSeparation.NoAffineInterval (Analog.HeterogeneousCompletionDensity.meanDomain φ₁) ψ₁ ∨
      Analog.CompletionSeparation.NoAffineInterval (Analog.HeterogeneousCompletionDensity.meanDomain φ₂) ψ₂)
  (hn :
    Analog.Operational.NonconstantOn
      (Analog.HeterogeneousScore.attainable (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂)) fun m =>
      ψ₁ m.1 + ψ₂ m.2)
  {P : ℝ} (hP : 0 ≤ P) :
  ∃ q e c,
    Analog.HeterogeneousAttainment.SDPFeasible (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂)
        (fun m => ψ₁ m.1 + ψ₂ m.2) P q ∧
      (∀ (q' : Analog.HeterogeneousAttainment.SDPPoint K),
          Analog.HeterogeneousAttainment.SDPFeasible (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂)
              (fun m => ψ₁ m.1 + ψ₂ m.2) P q' →
            q'.lam ≤ q.lam) ∧
        (∀ (k : Fin K),
            ∀ s ∈ Set.Icc (-1) 1,
              Analog.ArbitraryEncoder.squaredDistance
                  (Analog.HeterogeneousScore.encoder e c (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂) k s) 0 ≤
                P) ∧
          Analog.HeterogeneousScore.score (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂)
                (fun m => ψ₁ m.1 + ψ₂ m.2)
                (Analog.HeterogeneousScore.encoder e c (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂)) =
              ↑K ^ 2 * q.lam ∧
            ∀ (E : Fin K → ℝ → Analog.HeterogeneousRegularity.Plane),
              (∀ (k : Fin K), ContinuousOn (E k) (Set.Icc (-1) 1)) →
                (∀ (k : Fin K), ∀ s ∈ Set.Icc (-1) 1, Analog.ArbitraryEncoder.squaredDistance (E k s) 0 ≤ P) →
                  Analog.HeterogeneousScore.score (Analog.HeterogeneousFullRigidity.featurePairs φ₁ φ₂)
                      (fun m => ψ₁ m.1 + ψ₂ m.2) E ≤
                    ↑K ^ 2 * q.lam
Analog.HeterogeneousGrid.certified_discretization {K : ℕ} [NeZero K] (γ : Fin K → ℝ → ℝ × ℝ) (F : ℝ × ℝ → ℝ)
  (W : (k : Fin K) → Analog.TwoStatisticAttainment.Anchors (γ k)) (T : Fin K → Finset ℝ) (P h : ℝ) (hP : 0 < P)
  (hh : 0 ≤ h) (hn : Analog.Operational.NonconstantOn (Analog.HeterogeneousScore.attainable γ) F)
  (hW : ∀ (k : Fin K) (i : Fin 3), (W k).s i ∈ T k) (hTa : ∀ (k : Fin K), -1 ∈ T k) (hTb : ∀ (k : Fin K), 1 ∈ T k)
  (hT : ∀ (k : Fin K), ∀ t ∈ T k, t ∈ Set.Icc (-1) 1)
  (hspacing : ∀ (k : Fin K), ∀ l ∈ T k, ∀ r ∈ T k, l < r → (∀ t ∈ T k, l < t → t < r → False) → r - l ≤ h)
  (hγ : ∀ (k : Fin K), ContDiffOn ℝ 2 (γ k) (Set.Icc (-1) 1)) :
  ∃ Z₀ Z₁ Z₂ q qstar,
    (∀ (k : Fin K),
        (0 ≤ Z₀ k ∧ 0 ≤ Z₁ k ∧ 0 ≤ Z₂ k) ∧
          (∀ s ∈ Set.Icc (-1) 1, ‖Analog.HeterogeneousGrid.euclideanFeature (γ k) s‖ ≤ Z₀ k) ∧
            (∀ s ∈ Set.Icc (-1) 1, ‖Analog.HeterogeneousGrid.firstFeature (γ k) s‖ ≤ Z₁ k) ∧
              (∀ s ∈ Set.Icc (-1) 1, ‖Analog.HeterogeneousGrid.secondFeature (γ k) s‖ ≤ Z₂ k) ∧
                (∃ s ∈ Set.Icc (-1) 1, ‖Analog.HeterogeneousGrid.euclideanFeature (γ k) s‖ = Z₀ k) ∧
                  (∃ s ∈ Set.Icc (-1) 1, ‖Analog.HeterogeneousGrid.firstFeature (γ k) s‖ = Z₁ k) ∧
                    ∃ s ∈ Set.Icc (-1) 1, ‖Analog.HeterogeneousGrid.secondFeature (γ k) s‖ = Z₂ k) ∧
      Analog.HeterogeneousGridFeasible.Feasible γ (fun k => ↑(T k)) (Analog.HeterogeneousScore.attainable γ) F P q ∧
        (∀ (r : Fin K → Analog.SynthesisAttainment.Coordinates),
            Analog.HeterogeneousGridFeasible.Feasible γ (fun k => ↑(T k)) (Analog.HeterogeneousScore.attainable γ) F P
                r →
              r 0 6 ≤ q 0 6) ∧
          Analog.HeterogeneousGridFeasible.Feasible γ (fun x => Set.Icc (-1) 1) (Analog.HeterogeneousScore.attainable γ)
              F P qstar ∧
            (∀ (r : Fin K → Analog.SynthesisAttainment.Coordinates),
                Analog.HeterogeneousGridFeasible.Feasible γ (fun x => Set.Icc (-1) 1)
                    (Analog.HeterogeneousScore.attainable γ) F P r →
                  r 0 6 ≤ qstar 0 6) ∧
              have ρ := P / (P + Analog.HeterogeneousGrid.maxCurvature q Z₀ Z₁ Z₂ * h ^ 2 / 8);
              (Analog.HeterogeneousGridFeasible.Feasible γ (fun x => Set.Icc (-1) 1)
                  (Analog.HeterogeneousScore.attainable γ) F P fun k i => ρ * q k i) ∧
                ρ * q 0 6 ≤ qstar 0 6 ∧
                  qstar 0 6 ≤ q 0 6 ∧
                    ∃ e c,
                      (∀ (k : Fin K), ContinuousOn (Analog.HeterogeneousScore.encoder e c γ k) (Set.Icc (-1) 1)) ∧
                        (∀ (k : Fin K),
                            ∀ s ∈ Set.Icc (-1) 1,
                              Analog.ArbitraryEncoder.squaredDistance (Analog.HeterogeneousScore.encoder e c γ k s) 0 ≤
                                P) ∧
                          ↑K ^ 2 * (ρ * q 0 6) ≤
                            Analog.HeterogeneousScore.score γ F (Analog.HeterogeneousScore.encoder e c γ)
Analog.HeterogeneousDualCertificate.current_program_dual_upper_bound.{u_1, u_2} {K : ℕ} {τ : Type u_1}
