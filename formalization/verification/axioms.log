Analog.TwoStatisticDesign.affine_operational_score (e : Analog.GramSynthesis.Planar) {K : ℕ} (hK : 0 < K)
  (γ : ℝ → ℝ × ℝ) (F : ℝ × ℝ → ℝ) (hn : Analog.Operational.NonconstantOn (Analog.AdditiveStatistics.attainable K γ) F) :
  Analog.TwoStatisticDesign.score K γ F (Analog.AdditiveStatistics.encoder e γ) =
    ↑K ^ 2 *
      Analog.Operational.score (Analog.AdditiveStatistics.attainable K γ) F (Analog.TwoStatisticDesign.gramCost e)
Analog.TwoStatisticDesign.positive_definite_operational_synthesis {K : ℕ} (hK : 0 < K) (γ : ℝ → ℝ × ℝ) (F : ℝ × ℝ → ℝ)
  (hγ : ContinuousOn γ (Set.Icc (-1) 1))
  (hn : Analog.Operational.NonconstantOn (Analog.AdditiveStatistics.attainable K γ) F) (h l₁ l₂ A B C P lam : ℝ)
  (hA : 0 < A) (hD : 0 < Analog.GramSynthesis.det A B C) (hpsd : Analog.GramSynthesis.PSD3 h l₁ l₂ A B C)
  (hpeak : ∀ s ∈ Set.Icc (-1) 1, Analog.GramSynthesis.form3 h l₁ l₂ A B C 1 (γ s).1 (γ s).2 ≤ P)
  (hpairs :
    ∀ μ ∈ Analog.AdditiveStatistics.attainable K γ,
      ∀ ν ∈ Analog.AdditiveStatistics.attainable K γ,
        lam * (F μ - F ν) ^ 2 ≤ Analog.GramSynthesis.form2 A B C (μ.1 - ν.1) (μ.2 - ν.2)) :
  ∃ e,
    e.A = A ∧
      e.B = B ∧
        e.C = C ∧
          ContinuousOn (Analog.AdditiveStatistics.encoder e γ) (Set.Icc (-1) 1) ∧
            Analog.AdditiveStatistics.ExactComputation K γ F (Analog.AdditiveStatistics.encoder e γ) ∧
              (∀ s ∈ Set.Icc (-1) 1,
                  Analog.ArbitraryEncoder.squaredDistance (Analog.AdditiveStatistics.encoder e γ s) 0 ≤ P) ∧
                ↑K ^ 2 * lam ≤ Analog.TwoStatisticDesign.score K γ F (Analog.AdditiveStatistics.encoder e γ)
Analog.quadratic_variance_operational_optimal {K : ℕ} (hK : 2 ≤ K) (P : ℝ) (hP : 0 < P) :
  have e := Analog.Curve.scale (√P) Analog.optimalCurve;
  e.PeakFeasibleAt P ∧
    Analog.ArbitraryEncoder.varianceScore K e.encoder = 4 * ↑K ^ 2 * P / (9 + 6 * √3) ∧
      ∀ (other : Analog.Curve),
        other.PeakFeasibleAt P →
          Analog.ArbitraryEncoder.varianceScore K other.encoder ≤ Analog.ArbitraryEncoder.varianceScore K e.encoder
Analog.GeneralCollision.triple_collision_preserves_moments {K : ℕ} (hK : 4 ≤ K) (φ ψ : ℝ → ℝ) (E : ℝ → ℝ × ℝ)
  (hshape : StrictConvexOn ℝ (Set.Ioo (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Ioo (-1) 1) ψ)
  (hexact : Analog.GeneralCollision.ExactTarget K φ ψ E) (xs ys : List ℝ)
  (hxs : Analog.ArbitraryEncoder.ValidInput 3 xs) (hys : Analog.ArbitraryEncoder.ValidInput 3 ys)
  (hcollision : Analog.ArbitraryEncoder.received E xs = Analog.ArbitraryEncoder.received E ys) :
  Analog.ArbitraryEncoder.firstMoment xs = Analog.ArbitraryEncoder.firstMoment ys ∧
    Analog.GeneralCollision.featureMoment φ xs = Analog.GeneralCollision.featureMoment φ ys
Analog.Quartic.quartic_optimal_all_power (M P : ℝ) (hM : 0 < M) (hP : 0 < P) :
  ∃ r,
    (0 < r ∧ r < 1 / 3 ∧ Analog.Quartic.RootEquation M r) ∧
      have e := Analog.Curve.scale (√P) (Analog.Quartic.optimalPlanarCurve r);
      Analog.Quartic.CurvePeakFeasibleAt e P ∧
        Analog.Quartic.curveScore M e = P * (8 * r / (Analog.Quartic.denominator r * (M ^ 2 + 2 * r * (1 + r) ^ 2))) ∧
          ∀ (other : Analog.Curve),
            Analog.Quartic.CurvePeakFeasibleAt other P →
              Analog.Quartic.curveScore M other ≤ Analog.Quartic.curveScore M e
Analog.Decoder.sharp_uniform_decoder.{u_1, u_2} {X : Type u_1} {Y : Type u_2} [PseudoMetricSpace Y] (r : X → Y)
  (f : X → ℝ) (hn : Analog.Operational.NonconstantOn Set.univ f) (hscore : 0 < Analog.Decoder.metricScore r f) :
  ∃ D,
    LipschitzWith (Analog.Decoder.sharpConstant r f) D ∧
      Continuous D ∧
        (∀ (x : X), D (r x) = f x) ∧
          Analog.Decoder.UniformBound r f (Analog.Decoder.sharpConstant r f) D ∧
            ∀ (L : NNReal) (D' : Y → ℝ), Analog.Decoder.UniformBound r f L D' → Analog.Decoder.sharpConstant r f ≤ L
Analog.Decoder.zero_score_no_finite_uniform_decoder.{u_1, u_2} {X : Type u_1} {Y : Type u_2} [PseudoMetricSpace Y]
  (r : X → Y) (f : X → ℝ) (hn : Analog.Operational.NonconstantOn Set.univ f)
  (hzero : Analog.Decoder.metricScore r f = 0) : ¬∃ L D, Analog.Decoder.UniformBound r f L D
Analog.GramSynthesis.positive_sdp_synthesis (h l₁ l₂ A B C P lam a b c d : ℝ) (φ : ℝ → ℝ) (hlam : 0 < lam)
  (hind : a * d - b * c ≠ 0) (hpsd : Analog.GramSynthesis.PSD3 h l₁ l₂ A B C)
  (hfirst : Analog.GramSynthesis.RankOnePSD A B C lam a b) (hsecond : Analog.GramSynthesis.RankOnePSD A B C lam c d)
  (hpeak : ∀ (s : ℝ), -1 ≤ s → s ≤ 1 → Analog.GramSynthesis.form3 h l₁ l₂ A B C 1 s (φ s) ≤ P) :
  ∃ e,
    e.h = Analog.GramSynthesis.dual A B C l₁ l₂ ∧
      e.l₁ = l₁ ∧
        e.l₂ = l₂ ∧
          e.A = A ∧
            e.B = B ∧
              e.C = C ∧
                0 < e.A ∧
                  0 < Analog.GramSynthesis.det e.A e.B e.C ∧
                    Analog.GramSynthesis.RankOnePSD e.A e.B e.C lam a b ∧
                      Analog.GramSynthesis.RankOnePSD e.A e.B e.C lam c d ∧
                        ∀ (s : ℝ), -1 ≤ s → s ≤ 1 → e.energy 1 s (φ s) ≤ P
Analog.DifferentialRigidity.planar_differential_rigidity {a b : ℝ} (hab : a < b) {feature : ℝ → ℝ} {encoder : ℝ → ℝ × ℝ}
  (hfeature : ContinuousOn feature (Set.Icc a b)) (hencoder : ContinuousOn encoder (Set.Icc a b))
  (hdfeature : DifferentiableOn ℝ feature (Set.Ioo a b)) (hdencoder : DifferentiableOn ℝ encoder (Set.Ioo a b))
  (hnonaffine : ¬∃ c α, ∀ x ∈ Set.Icc a b, feature x = c + α * x)
  (hkernelx :
    Analog.DifferentialRigidity.TripleKernelAnnihilation (Set.Ioo a b) (deriv feature) (deriv fun x => (encoder x).1))
  (hkernely :
    Analog.DifferentialRigidity.TripleKernelAnnihilation (Set.Ioo a b) (deriv feature) (deriv fun x => (encoder x).2)) :
  ∃ c u v, ∀ x ∈ Set.Icc a b, encoder x = c + x • u + feature x • v
Analog.GeneralScore.general_operational_score (e : Analog.Curve) {K : ℕ} (hK : 2 ≤ K) (φ ψ : ℝ → ℝ)
  (hD : 0 < Analog.GramSynthesis.det e.A e.B e.C)
  (hφ : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ)
  (hdφ : ∀ z ∈ Set.Ioo (-1) 1, DifferentiableAt ℝ φ z)
  (hψ : ConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ ConcaveOn ℝ (Set.Icc (-1) 1) ψ) (hdψ : DifferentiableOn ℝ ψ (Set.Icc (-1) 1))
  (hcψ : ContinuousOn (Analog.GeneralScore.readoutSlope ψ) (Set.Icc (-1) 1)) :
  Analog.GeneralScore.score K φ ψ e = ↑K ^ 2 / Analog.GeneralScore.endpointDual e ψ
Analog.GeneralScore.general_score_small_distance_sharpness (e : Analog.Curve) {K : ℕ} (hK : 2 ≤ K) (φ ψ : ℝ → ℝ)
  (hD : 0 < Analog.GramSynthesis.det e.A e.B e.C)
  (hφ : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ)
  (hdφ : ∀ z ∈ Set.Ioo (-1) 1, DifferentiableAt ℝ φ z)
  (hψ : ConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ ConcaveOn ℝ (Set.Icc (-1) 1) ψ) (hdψ : DifferentiableOn ℝ ψ (Set.Icc (-1) 1))
  (hcψ : ContinuousOn (Analog.GeneralScore.readoutSlope ψ) (Set.Icc (-1) 1)) (ε δ : ℝ) (hε : 0 < ε) (hδ : 0 < δ) :
  ∃ xs ys,
    Analog.ArbitraryEncoder.ValidInput K xs ∧
      Analog.ArbitraryEncoder.ValidInput K ys ∧
        Analog.GeneralCollision.target K φ ψ xs ≠ Analog.GeneralCollision.target K φ ψ ys ∧
          Analog.ArbitraryEncoder.squaredDistance
                (Analog.ArbitraryEncoder.received (Analog.GeneralScore.encoder e φ) xs)
                (Analog.ArbitraryEncoder.received (Analog.GeneralScore.encoder e φ) ys) <
              δ ^ 2 ∧
            Analog.ArbitraryEncoder.squaredDistance
                  (Analog.ArbitraryEncoder.received (Analog.GeneralScore.encoder e φ) xs)
                  (Analog.ArbitraryEncoder.received (Analog.GeneralScore.encoder e φ) ys) /
                (Analog.GeneralCollision.target K φ ψ xs - Analog.GeneralCollision.target K φ ψ ys) ^ 2 <
              Analog.GeneralScore.score K φ ψ e + ε
Analog.GeneralDesign.positive_sdp_operational_synthesis {K : ℕ} (hK : 2 ≤ K) (φ ψ : ℝ → ℝ) (h l₁ l₂ A B C P lam : ℝ)
  (hcφ : ContinuousOn φ (Set.Icc (-1) 1))
  (hφ : StrictConvexOn ℝ (Set.Icc (-1) 1) φ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) φ)
  (hdφ : ∀ z ∈ Set.Ioo (-1) 1, DifferentiableAt ℝ φ z)
  (hψ : StrictConvexOn ℝ (Set.Icc (-1) 1) ψ ∨ StrictConcaveOn ℝ (Set.Icc (-1) 1) ψ)
  (hdψ : DifferentiableOn ℝ ψ (Set.Icc (-1) 1))
  (hcψ : ContinuousOn (Analog.GeneralScore.readoutSlope ψ) (Set.Icc (-1) 1)) (hlam : 0 < lam)
  (hpsd : Analog.GramSynthesis.PSD3 h l₁ l₂ A B C)
  (hfirst : Analog.GramSynthesis.RankOnePSD A B C lam (-Analog.GeneralScore.readoutSlope ψ (-1)) 1)
  (hsecond : Analog.GramSynthesis.RankOnePSD A B C lam (-Analog.GeneralScore.readoutSlope ψ 1) 1)
  (hpeak : ∀ (s : ℝ), -1 ≤ s → s ≤ 1 → Analog.GramSynthesis.form3 h l₁ l₂ A B C 1 s (φ s) ≤ P) :
  ∃ e,
