  ∃ mstar ∈ M,
    (∀ m ∈ M,
        Analog.FixedPriorGaussianLimit.planeCoefficient r₁ r₂ T m ≤
          Analog.FixedPriorGaussianLimit.planeCoefficient r₁ r₂ T mstar) ∧
      Measurable (Analog.FixedPriorGaussianLimit.planeDecoder r₁ r₂ T c) ∧
        (∀ (v : NNReal),
            v ≠ 0 →
              Analog.GaussianWorstCase.worstRisk M (Analog.FixedPriorGaussianLimit.planeTarget r₁ r₂)
                  (Analog.FixedPriorGaussianLimit.planeDecoder r₁ r₂ T c) (Analog.GaussianBayesConverse.receiverFirst T)
                  (Analog.GaussianBayesConverse.receiverSecond T) c v ≠
                ⊤) ∧
          Filter.Tendsto
              (fun v =>
                Analog.GaussianWorstCase.minimaxRisk M (Analog.FixedPriorGaussianLimit.planeTarget r₁ r₂)
                    (Analog.GaussianBayesConverse.receiverFirst T) (Analog.GaussianBayesConverse.receiverSecond T) c v /
                  (2 * ↑v))
              (nhdsWithin 0 (Set.Ioi 0)) (nhds (Analog.FixedPriorGaussianLimit.planeCoefficient r₁ r₂ T mstar)) ∧
            Filter.Tendsto
              (fun v =>
                (Analog.GaussianWorstCase.worstRisk M (Analog.FixedPriorGaussianLimit.planeTarget r₁ r₂)
                      (Analog.FixedPriorGaussianLimit.planeDecoder r₁ r₂ T c)
                      (Analog.GaussianBayesConverse.receiverFirst T) (Analog.GaussianBayesConverse.receiverSecond T) c
                      v).toReal /
